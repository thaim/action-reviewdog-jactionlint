{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "customManagers": [
    {
      "description": "Update the default of the jactionlint_version input in action.yml and its copy in README, marked by a renovate comment. The release tags of jdx/jactionlint have a v prefix and the input does not.",
      "customType": "regex",
      "managerFilePatterns": ["/^action\\.yml$/", "/^README\\.md$/"],
      "matchStrings": ["default: '(?<currentValue>\\d+\\.\\d+\\.\\d+)' # renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)"],
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "description": "Update the reviewdog version passed to reviewdog/action-setup.",
      "customType": "regex",
      "managerFilePatterns": ["/^action\\.yml$/"],
      "matchStrings": ["reviewdog_version: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "reviewdog/reviewdog",
      "datasourceTemplate": "github-releases"
    }
  ]
}
